  "reconciliation_flows": [
    {
      "reconciliation_id": "recon_ref_full_reference",
      "execution_mode": "job",
      "source_config": {
        "type": "table",
        "table": "{{catalog}}.ref_bronze.ref_reconciliation_baseline",
        "read_mode": "batch",
        "task_run_id_column": "__framework_pipeline_run_id",
        "filter_condition": "load_date = ${run_date}",
        "data_standardization_sql": [
          "trim(status_code) AS status_code"
        ],
        "hash_precomputed": false
      },
      "target_configs": [
        {
          "target_id": "ref_table_target",
          "type": "table",
          "table": "{{catalog}}.ref_silver.ref_scd1",
          "read_mode": "batch",
          "hash_precomputed": true,
          "comparison_direction": "both",
          "append_target_table": "{{catalog}}.ref_silver.ref_scd1_cdc"
        },
        {
          "target_id": "ref_file_readback_target",
          "type": "table",
          "table": "{{catalog}}.ref_silver.ref_file_export_readback",
          "read_mode": "streaming",
          "filter_condition": "status_code IS NOT NULL",
          "data_standardization_sql": [
            "upper(status_code) AS status_code"
          ],
          "comparison_direction": "source_to_target",
          "append_target_table": "{{catalog}}.ref_silver.ref_file_target_cdc"
        },
        {
          "target_id": "ref_sink_readback_target",
          "type": "table",
          "table": "{{catalog}}.ref_silver.ref_pure_sink_readback",
          "read_mode": "batch",
          "comparison_direction": "target_to_source"
        }
      ],
      "match_keys": [
        "customer_id"
      ],
      "compare_columns": [
        "amount",
        "status_code"
      ],
      "transform_sql": "SELECT customer_id, amount, status_code FROM _reconciliation_unmatched_records WHERE status_code IS NOT NULL",
      "error_handling": {
        "on_failure": "fail"
      },
      "two_tier_verification": true,
      "logging_config": {
        "run_log_capture": true,
        "mismatch_log_capture": true
      }
    },
    {
      "reconciliation_id": "recon_ref_warn_minimal",
      "source_config": {
        "type": "table",
        "table": "{{catalog}}.ref_bronze.ref_secondary_baseline"
      },
      "target_configs": [
        {
          "target_id": "ref_secondary",
          "type": "table",
          "table": "{{catalog}}.ref_silver.ref_secondary_final",
          "comparison_direction": "source_to_target",
          "append_target_table": "{{catalog}}.ref_silver.ref_secondary_cdc"
        }
      ],
      "match_keys": [
        "customer_id"
      ],
      "error_handling": {
        "on_failure": "warn"
      },
      "two_tier_verification": false,
      "logging_config": {
        "run_log_capture": true,
        "mismatch_log_capture": false
      }
