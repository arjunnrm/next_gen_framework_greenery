      },
      "two_tier_verification": true,
      "logging_config": {
        "run_log_capture": true,
        "mismatch_log_capture": false
      }
    }
  ],
  "observability": [
    {
      "id": "dest-dbx-volume-example",
      "enabled": true,
      "type": "DATABRICKS_VOLUME",
      "destination_config": {
