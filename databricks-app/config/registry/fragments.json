{
  "secret_ref": {
    "params": [
      "required"
    ],
    "fields": [
      {
        "path": "secret_catalog",
        "widget": "text",
        "type": "string",
        "indent": 1,
        "required": "{{required}}",
        "placeholder": "{{catalog}}",
        "description": "Unity Catalog secret catalog holding the key."
      },
      {
        "path": "secret_schema",
        "widget": "text",
        "type": "string",
        "indent": 1,
        "required": "{{required}}",
        "placeholder": "security",
        "description": "Unity Catalog secret schema."
      },
      {
        "path": "secret_key",
        "widget": "text",
        "type": "string",
        "indent": 1,
        "required": "{{required}}",
        "placeholder": "pii_encryption_key",
        "description": "UC secret key name. AES keys must be exactly 16, 24 or 32 bytes."
      }
    ]
  },
  "recon_dataset": {
    "params": [],
    "fields": [
      {
        "path": "type",
        "widget": "select",
        "type": "string",
        "default": "table",
        "options": [
          "table"
        ],
        "description": "Reconciliation is scoped to Delta tables only. Any other value is rejected outright."
      },
      {
        "path": "table",
        "widget": "text",
        "type": "string",
        "required": true,
        "placeholder": "{{catalog}}.bronze.table",
        "description": "Three-part fully-qualified table name (catalog.schema.table)."
      },
      {
        "path": "read_mode",
        "widget": "select",
        "type": "string",
        "default": "batch",
        "options": [
          "batch",
          "streaming"
        ],
        "description": "At most one side of a given target's comparison may be streaming."
      },
      {
        "path": "task_run_id_column",
        "widget": "text",
        "type": "string",
        "placeholder": "__framework_pipeline_run_id",
        "description": "When the task_run_id job parameter is set, narrows this side's read to that run's rows. Reconciliation is triggered-only as of v1.4.0."
      },
      {
        "path": "filter_condition",
        "widget": "sql",
        "type": "string",
        "span": 2,
        "placeholder": "load_date = '${run_date}'",
        "description": "Boolean SQL condition applied after read. Supports ${param} substitution."
      },
      {
        "path": "data_standardization_sql",
        "widget": "list",
        "type": "array<string>",
        "span": 2,
        "placeholder": "trim(status) AS status",
        "description": "Column-level cleanup expressions before matching. Same restricted grammar as ingestion."
      },
      {
        "path": "hash_precomputed",
        "widget": "boolean",
        "type": "boolean",
        "default": false,
        "description": "Reuse existing __framework_hash_key and __framework_hash_value instead of recomputing."
      }
    ]
  }
}
