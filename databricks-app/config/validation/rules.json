{
  "rules": [
    {
      "id": "one_flow_array_required",
      "severity": "error",
      "scope": "spec",
      "when": {
        "and": [
          {
            "empty": [
              "@ingestion_flows"
            ]
          },
          {
            "empty": [
              "@transformation_flows"
            ]
          },
          {
            "empty": [
              "@reconciliation_flows"
            ]
          }
        ]
      },
      "message": "At least one of ingestion_flows, transformation_flows or reconciliation_flows must be non-empty. observability does not count.",
      "field_path": null,
      "doc": "#1-top-level-spec-schema"
    },
    {
      "id": "dataflow_group_id_pattern",
      "severity": "error",
      "scope": "spec",
      "when": {
        "and": [
          {
            "nonempty": [
              "@dataflow_group_id"
            ]
          },
          {
            "not": {
              "matches": [
                "@dataflow_group_id",
                "^[A-Za-z0-9_]+$"
              ]
            }
          }
        ]
      },
      "message": "dataflow_group_id must contain only alphanumeric characters and underscores.",
      "field_path": "dataflow_group_id"
    },
    {
      "id": "iceberg_batch_table_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "target_config.storage_format",
              "iceberg"
            ]
          },
          {
            "ne": [
              "target_type",
              "batch_table"
            ]
          }
        ]
      },
      "message": "storage_format iceberg is only valid when target_type is batch_table. For other target types keep delta and set the table property enable_iceberg_read_uniformity: true.",
      "field_path": "target_config.storage_format"
    },
    {
      "id": "scd_requires_primary_keys",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "in": [
              "target_config.cdc_load_strategy",
              [
                "SCD1",
                "SCD2",
                "SCD3",
                "FULL_SNAPSHOT_CDC"
              ]
            ]
          },
          {
            "empty": [
              "target_config.primary_keys"
            ]
          }
        ]
      },
      "message": "primary_keys is required when cdc_load_strategy is SCD1, SCD2, SCD3 or FULL_SNAPSHOT_CDC. As of v1.4.0 every CDC-dispatched strategy needs a real key -- the keyless snapshot variant was withdrawn with the surrogate-key engine, and the framework no longer manufactures one. Use TRUNCATE_AND_LOAD if the source has no key.",
      "field_path": "target_config.primary_keys"
    },
    {
      "id": "scd3_transformation_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "target_config.cdc_load_strategy",
              "SCD3"
            ]
          },
          {
            "eq": [
              "@__flow_kind",
              "ingestion"
            ]
          }
        ]
      },
      "message": "SCD3 is only valid for transformation flows.",
      "field_path": "target_config.cdc_load_strategy"
    },
    {
      "id": "scd3_requires_columns_to_check",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "target_config.cdc_load_strategy",
              "SCD3"
            ]
          },
          {
            "empty": [
              "target_config.columns_to_check"
            ]
          }
        ]
      },
      "message": "columns_to_check is required when cdc_load_strategy is SCD3.",
      "field_path": "target_config.columns_to_check"
    },
    {
      "id": "columns_to_exclude_cdc_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.columns_to_exclude"
            ]
          },
          {
            "nin": [
              "target_config.cdc_load_strategy",
              [
                "SCD1",
                "SCD2",
                "SCD3"
              ]
            ]
          }
        ]
      },
      "message": "columns_to_exclude is only meaningful for SCD1, SCD2 and SCD3 -- a validation error on APPEND, TRUNCATE_AND_LOAD and FULL_SNAPSHOT_CDC, none of which have a comparison-column concept to exclude from.",
      "field_path": "target_config.columns_to_exclude"
    },
    {
      "id": "auto_ttl_appendish_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "or": [
              {
                "nonempty": [
                  "target_config.auto_ttl.timestamp_column"
                ]
              },
              {
                "nonempty": [
                  "target_config.auto_ttl.expire_in_days"
                ]
              }
            ]
          },
          {
            "nin": [
              "target_config.cdc_load_strategy",
              [
                "APPEND",
                "TRUNCATE_AND_LOAD"
              ]
            ]
          }
        ]
      },
      "message": "auto_ttl is only valid for APPEND and TRUNCATE_AND_LOAD strategies.",
      "field_path": "target_config.auto_ttl.timestamp_column"
    },
    {
      "id": "auto_ttl_pair",
      "severity": "error",
      "scope": "flow",
      "when": {
        "or": [
          {
            "and": [
              {
                "nonempty": [
                  "target_config.auto_ttl.timestamp_column"
                ]
              },
              {
                "empty": [
                  "target_config.auto_ttl.expire_in_days"
                ]
              }
            ]
          },
          {
            "and": [
              {
                "empty": [
                  "target_config.auto_ttl.timestamp_column"
                ]
              },
              {
                "nonempty": [
                  "target_config.auto_ttl.expire_in_days"
                ]
              }
            ]
          }
        ]
      },
      "message": "Both auto_ttl.timestamp_column and auto_ttl.expire_in_days must be provided together.",
      "field_path": "target_config.auto_ttl.timestamp_column"
    },
    {
      "id": "delete_values_needs_operation_column",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.cdc_operation_mapping.delete_values"
            ]
          },
          {
            "empty": [
              "target_config.cdc_operation_column"
            ]
          }
        ]
      },
      "message": "cdc_operation_mapping.delete_values requires cdc_operation_column to be configured.",
      "field_path": "target_config.cdc_operation_column"
    },
    {
      "id": "cdc_operation_column_scope",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "or": [
              {
                "nonempty": [
                  "target_config.cdc_operation_column"
                ]
              },
              {
                "nonempty": [
                  "target_config.cdc_operation_mapping.delete_values"
                ]
              }
            ]
          },
          {
            "nin": [
              "target_config.cdc_load_strategy",
              [
                "SCD1",
                "SCD2",
                "FULL_SNAPSHOT_CDC"
              ]
            ]
          }
        ]
      },
      "message": "cdc_operation_column / cdc_operation_mapping.delete_values are only meaningful for SCD1, SCD2 and FULL_SNAPSHOT_CDC. SCD3 is a current/previous pivot with no delete path, and onboarding rejects the pair on it.",
      "field_path": "target_config.cdc_operation_column"
    },
    {
      "id": "sink_requires_sink_config",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "in": [
              "target_type",
              [
                "sink",
                "external_sink"
              ]
            ]
          },
          {
            "empty": [
              "target_config.sink_config.format"
            ]
          }
        ]
      },
      "message": "sink_config.format is required when target_type is sink or external_sink.",
      "field_path": "target_config.sink_config.format"
    },
    {
      "id": "sink_path_required",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "in": [
              "target_type",
              [
                "sink",
                "external_sink"
              ]
            ]
          },
          {
            "ne": [
              "target_config.sink_config.format",
              "kafka"
            ]
          },
          {
            "empty": [
              "target_config.sink_config.path"
            ]
          }
        ]
      },
      "message": "target_config.sink_config.path is required for non-Kafka sink exports.",
      "field_path": "target_config.sink_config.path"
    },
    {
      "id": "kafka_sink_requires_options",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "target_config.sink_config.format",
              "kafka"
            ]
          },
          {
            "empty": [
              "target_config.sink_config.kafka_options"
            ]
          }
        ]
      },
      "message": "sink_config.kafka_options is required for a kafka sink and must include both 'kafka.bootstrap.servers' and 'topic' -- the same options a Spark Structured Streaming Kafka writer takes. A kafka sink has no filesystem path.",
      "field_path": "target_config.sink_config.kafka_options"
    },
    {
      "id": "watermark_pair",
      "severity": "error",
      "scope": "flow",
      "when": {
        "or": [
          {
            "and": [
              {
                "nonempty": [
                  "source_config.dedup_watermark.event_time_column"
                ]
              },
              {
                "empty": [
                  "source_config.dedup_watermark.delay_threshold"
                ]
              }
            ]
          },
          {
            "and": [
              {
                "empty": [
                  "source_config.dedup_watermark.event_time_column"
                ]
              },
              {
                "nonempty": [
                  "source_config.dedup_watermark.delay_threshold"
                ]
              }
            ]
          }
        ]
      },
      "message": "Both dedup_watermark.event_time_column and dedup_watermark.delay_threshold must be specified together.",
      "field_path": "source_config.dedup_watermark.event_time_column"
    },
    {
      "id": "remove_dups_streaming_unbounded",
      "severity": "warning",
      "scope": "flow",
      "when": {
        "and": [
          {
            "truthy": [
              "source_config.remove_dups"
            ]
          },
          {
            "empty": [
              "source_config.dedup_watermark.event_time_column"
            ]
          }
        ]
      },
      "message": "remove_dups on a streaming source with no dedup_watermark holds unbounded dedup state.",
      "field_path": "source_config.dedup_watermark.event_time_column"
    },
    {
      "id": "archive_path_missing_degrades",
      "severity": "warning",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "source_config.landing_retention_policy.clean_source",
              "archive"
            ]
          },
          {
            "empty": [
              "source_config.landing_retention_policy.archive_path"
            ]
          }
        ]
      },
      "message": "clean_source: archive with an empty archive_path degrades to off at runtime.",
      "field_path": "source_config.landing_retention_policy.archive_path"
    },
    {
      "id": "explode_named_but_auto_flatten",
      "severity": "warning",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "source_config.explode_mode",
              "named"
            ]
          },
          {
            "truthy": [
              "source_config.auto_flatten_all"
            ]
          }
        ]
      },
      "message": "auto_flatten_all: true overrides explode_mode: named and flattens all nested columns.",
      "field_path": "source_config.auto_flatten_all"
    },
    {
      "id": "recon_append_target_required",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "ne": [
              "comparison_direction",
              "target_to_source"
            ]
          },
          {
            "empty": [
              "append_target_table"
            ]
          }
        ]
      },
      "message": "append_target_table is required when reconciliation comparison_direction includes source-to-target healing.",
      "field_path": "append_target_table"
    },
    {
      "id": "observability_continuous_tables",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "observability"
            ]
          },
          {
            "eq": [
              "mode",
              "continuous"
            ]
          },
          {
            "empty": [
              "destination_config.event_log_tables"
            ]
          }
        ]
      },
      "message": "destination_config.event_log_tables is required when observability mode is continuous.",
      "field_path": "destination_config.event_log_tables"
    },
    {
      "id": "observability_volume_path",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "observability"
            ]
          },
          {
            "ne": [
              "type",
              "OTLP_CONSUMER"
            ]
          },
          {
            "empty": [
              "destination_config.volume_path"
            ]
          }
        ]
      },
      "message": "destination_config.volume_path is required for DATABRICKS_VOLUME observability destinations.",
      "field_path": "destination_config.volume_path"
    },
    {
      "id": "observability_otlp_endpoint",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "observability"
            ]
          },
          {
            "eq": [
              "type",
              "OTLP_CONSUMER"
            ]
          },
          {
            "empty": [
              "destination_config.endpoint"
            ]
          }
        ]
      },
      "message": "destination_config.endpoint is required for OTLP_CONSUMER observability destinations.",
      "field_path": "destination_config.endpoint"
    },
    {
      "id": "recon_publish_schema_pipeline_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "nonempty": [
              "publish_schema"
            ]
          },
          {
            "nin": [
              "execution_mode",
              [
                "pipeline",
                "pipeline_audit_only"
              ]
            ]
          }
        ]
      },
      "message": "publish_schema is only meaningful when execution_mode is 'pipeline' or 'pipeline_audit_only', and is rejected on presence when execution_mode is 'job' -- a job-mode flow publishes no classified/metrics/mismatch datasets to place in a schema. Clear publish_schema, or set execution_mode to 'pipeline'.",
      "field_path": "publish_schema",
      "doc": "#8-reconciliation-flow-schema"
    },
    {
      "id": "recon_dq_config_pipeline_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "nonempty": [
              "dq_config.rules"
            ]
          },
          {
            "nin": [
              "execution_mode",
              [
                "pipeline",
                "pipeline_audit_only"
              ]
            ]
          }
        ]
      },
      "message": "dq_config is only meaningful when execution_mode is 'pipeline' or 'pipeline_audit_only', and is rejected on presence when execution_mode is 'job' -- a job task has no dataset to attach expectations to. Remove the expectations, or set execution_mode to 'pipeline'. error_handling.on_failure is unaffected: it keeps its exception-level try/except meaning in both modes.",
      "field_path": "dq_config.rules",
      "doc": "#8-reconciliation-flow-schema"
    },
    {
      "id": "recon_streaming_read_mode_not_in_pipeline_mode",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "in": [
              "execution_mode",
              [
                "pipeline",
                "pipeline_audit_only"
              ]
            ]
          },
          {
            "eq": [
              "source_config.read_mode",
              "streaming"
            ]
          }
        ]
      },
      "message": "source_config.read_mode 'streaming' is not supported when execution_mode is 'pipeline'. Use read_mode 'batch' (the default), or set execution_mode to 'job' to keep the standalone streaming engine. The in-pipeline comparison is a whole-snapshot batch classification, and a stream-static join supports only inner and left_outer, which cannot express MISSING_IN_SOURCE.",
      "field_path": "source_config.read_mode",
      "doc": "#8-reconciliation-flow-schema"
    },
    {
      "id": "recon_task_run_id_column_not_in_pipeline_mode",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "in": [
              "execution_mode",
              [
                "pipeline",
                "pipeline_audit_only"
              ]
            ]
          },
          {
            "nonempty": [
              "source_config.task_run_id_column"
            ]
          }
        ]
      },
      "message": "source_config.task_run_id_column is rejected on presence when execution_mode is 'pipeline' or 'pipeline_audit_only': no stable per-update key exists inside a Lakeflow update, so narrowing by it would match every row that pipeline ever wrote -- a silent no-op rather than a filter. Use filter_condition, or set execution_mode to 'job'.",
      "field_path": "source_config.task_run_id_column",
      "doc": "#8-reconciliation-flow-schema"
    },
    {
      "id": "recon_pipeline_graph_checks_deferred_to_onboarding",
      "severity": "warning",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "in": [
              "execution_mode",
              [
                "pipeline",
                "pipeline_audit_only"
              ]
            ]
          }
        ]
      },
      "message": "In-pipeline reconciliation adds graph-shape rules this builder cannot check: the predicate engine evaluates one flow at a time and has no way to compare a value in this flow against a value in ingestion_flows[] or transformation_flows[], so V-CYC-1 (source_config.table must be a target THIS dataflow group publishes), V-CYC-2 (append_target_table must not be one of this group's own targets) and V-CYC-3 (append_target_table must not be an ingestion source this group reads) are enforced by the framework validator at onboarding, not here. A deliberate asymmetry -- expect these to be re-checked, and possibly rejected, when the spec is onboarded.",
      "field_path": "execution_mode",
      "doc": "#8-reconciliation-flow-schema"
    },
    {
      "id": "recon_dq_rules_require_run_log_capture",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "nonempty": [
              "dq_config.rules"
            ]
          },
          {
            "eq": [
              "logging_config.run_log_capture",
              false
            ]
          }
        ]
      },
      "message": "logging_config.run_log_capture: false is incompatible with dq_config.rules -- the flow's expectations attach to its recon__*__metrics dataset, which is only registered when run_log_capture is true (v1.6.0). Remove the dq_config rules or re-enable run_log_capture.",
      "field_path": "logging_config.run_log_capture",
      "doc": "#8-reconciliation-flow-schema"
    },
    {
      "id": "recon_audit_only_needs_one_capture_flag",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "@__flow_kind",
              "reconciliation"
            ]
          },
          {
            "eq": [
              "execution_mode",
              "pipeline_audit_only"
            ]
          },
          {
            "eq": [
              "logging_config.run_log_capture",
              false
            ]
          },
          {
            "eq": [
              "logging_config.mismatch_log_capture",
              false
            ]
          }
        ]
      },
      "message": "execution_mode 'pipeline_audit_only' with both run_log_capture and mismatch_log_capture false registers compute with no output at all (v1.6.0 -- the audit-only mode exists solely to produce the metrics/mismatch datasets and their control-table exports). Enable at least one capture flag, or use execution_mode 'job'/'pipeline'.",
      "field_path": "logging_config.mismatch_log_capture",
      "doc": "#8-reconciliation-flow-schema"
    },
    {
      "id": "staged_file_format_pgp_zip_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.sink_config.staged_file_format"
            ]
          },
          {
            "ne": [
              "target_config.sink_config.format",
              "pgp_zip"
            ]
          }
        ]
      },
      "message": "sink_config.staged_file_format is only meaningful for format 'pgp_zip' (the framework's staging-then-archive sink); 'delta' and 'kafka' are native Lakeflow sinks with no staging step. Remove the attribute.",
      "field_path": "target_config.sink_config.staged_file_format",
      "doc": "#5-sink-configuration"
    },
    {
      "id": "member_format_enum",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "source_config.source_zip_handling.member_format"
            ]
          },
          {
            "nin": [
              "source_config.source_zip_handling.member_format",
              [
                "zip",
                "gzip"
              ]
            ]
          }
        ]
      },
      "message": "source_config.source_zip_handling.member_format must be one of ['gzip', 'zip']. 'zip' (the default when absent) is a real archive with named members; 'gzip' is a single compressed stream.",
      "field_path": "source_config.source_zip_handling.member_format",
      "doc": "#2-ingestion-and-sources"
    },
    {
      "id": "gzip_member_rejects_zip_passphrase",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "source_config.source_zip_handling.member_format",
              "gzip"
            ]
          },
          {
            "nonempty": [
              "source_config.source_zip_handling.pre_extraction_decryption.secret_passphrase.secret_key"
            ]
          }
        ]
      },
      "message": "pre_extraction_decryption.secret_passphrase has no meaning for member_format 'gzip' -- a gzip stream has no archive password. It is the AES password on a ZIP archive. Remove it, or use member_format 'zip'.",
      "field_path": "source_config.source_zip_handling.pre_extraction_decryption.secret_passphrase.secret_key",
      "doc": "#2-ingestion-and-sources"
    },
    {
      "id": "pgp_symmetric_requires_passphrase",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "source_config.source_zip_handling.pre_extraction_decryption.type",
              "pgp_symmetric"
            ]
          },
          {
            "empty": [
              "source_config.source_zip_handling.pre_extraction_decryption.passphrase_secret.secret_key"
            ]
          }
        ]
      },
      "message": "pre_extraction_decryption.passphrase_secret is required for type 'pgp_symmetric' -- a passphrase-encrypted OpenPGP message has no recipient keypair to decrypt with.",
      "field_path": "source_config.source_zip_handling.pre_extraction_decryption.passphrase_secret.secret_key",
      "doc": "#2-ingestion-and-sources"
    },
    {
      "id": "pgp_symmetric_rejects_private_key",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "source_config.source_zip_handling.pre_extraction_decryption.type",
              "pgp_symmetric"
            ]
          },
          {
            "nonempty": [
              "source_config.source_zip_handling.pre_extraction_decryption.private_key_secret.secret_key"
            ]
          }
        ]
      },
      "message": "source_config.source_zip_handling.pre_extraction_decryption.private_key_secret: not valid for type 'pgp_symmetric' -- a passphrase-encrypted OpenPGP message has no recipient keypair. Use type 'pgp' for a key-encrypted message.",
      "field_path": "source_config.source_zip_handling.pre_extraction_decryption.private_key_secret.secret_key",
      "doc": "#2-ingestion-and-sources"
    },
    {
      "id": "staged_file_options_csv_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "or": [
              {
                "nonempty": [
                  "target_config.sink_config.staged_file_options.delimiter"
                ]
              },
              {
                "nonempty": [
                  "target_config.sink_config.staged_file_options.line_terminator"
                ]
              },
              {
                "set": [
                  "target_config.sink_config.staged_file_options.include_header"
                ]
              }
            ]
          },
          {
            "ne": [
              "target_config.sink_config.staged_file_format",
              "csv"
            ]
          }
        ]
      },
      "message": "sink_config.staged_file_options only applies when staged_file_format is 'csv'. A JSON-Lines export has no delimiter, header row or configurable record separator.",
      "field_path": "target_config.sink_config.staged_file_options.delimiter",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "staged_delimiter_single_character",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.sink_config.staged_file_options.delimiter"
            ]
          },
          {
            "not": {
              "matches": [
                "target_config.sink_config.staged_file_options.delimiter",
                "^.$"
              ]
            }
          }
        ]
      },
      "message": "target_config.sink_config.staged_file_options.delimiter: must be exactly one character -- Python's csv writer cannot emit a multi-character delimiter.",
      "field_path": "target_config.sink_config.staged_file_options.delimiter",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "staged_line_terminator_enum",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.sink_config.staged_file_options.line_terminator"
            ]
          },
          {
            "nin": [
              "target_config.sink_config.staged_file_options.line_terminator",
              [
                "crlf",
                "lf"
              ]
            ]
          }
        ]
      },
      "message": "target_config.sink_config.staged_file_options.line_terminator must be one of ['crlf', 'lf']. It is spelled as a name because JSON cannot carry a bare control character.",
      "field_path": "target_config.sink_config.staged_file_options.line_terminator",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "archive_format_enum",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.sink_config.post_export_archive.archive_format"
            ]
          },
          {
            "nin": [
              "target_config.sink_config.post_export_archive.archive_format",
              [
                "zip",
                "gzip"
              ]
            ]
          }
        ]
      },
      "message": "target_config.sink_config.post_export_archive.archive_format: must be one of ['gzip', 'zip']",
      "field_path": "target_config.sink_config.post_export_archive.archive_format",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "pgp_encryption_exactly_one_secret",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "target_config.sink_config.post_export_archive.pgp_encryption.enabled",
              true
            ]
          },
          {
            "nonempty": [
              "target_config.sink_config.post_export_archive.pgp_encryption.passphrase_secret.secret_key"
            ]
          },
          {
            "nonempty": [
              "target_config.sink_config.post_export_archive.pgp_encryption.recipient_public_key_secret.secret_key"
            ]
          }
        ]
      },
      "message": "target_config.sink_config.post_export_archive.pgp_encryption: 'passphrase_secret' (symmetric) and 'recipient_public_key_secret' (asymmetric) are mutually exclusive -- set exactly one.",
      "field_path": "target_config.sink_config.post_export_archive.pgp_encryption.passphrase_secret.secret_key",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "pgp_encryption_requires_a_secret",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "target_config.sink_config.post_export_archive.pgp_encryption.enabled",
              true
            ]
          },
          {
            "empty": [
              "target_config.sink_config.post_export_archive.pgp_encryption.passphrase_secret.secret_key"
            ]
          },
          {
            "empty": [
              "target_config.sink_config.post_export_archive.pgp_encryption.recipient_public_key_secret.secret_key"
            ]
          }
        ]
      },
      "message": "target_config.sink_config.post_export_archive.pgp_encryption is enabled but neither 'recipient_public_key_secret' (encrypt to a recipient key) nor 'passphrase_secret' (encrypt with a shared passphrase) is set -- set exactly one.",
      "field_path": "target_config.sink_config.post_export_archive.pgp_encryption.recipient_public_key_secret.secret_key",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "pgp_symmetric_egress_rejects_signing",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.sink_config.post_export_archive.pgp_encryption.passphrase_secret.secret_key"
            ]
          },
          {
            "nonempty": [
              "target_config.sink_config.post_export_archive.pgp_encryption.sign_with_private_key_secret.secret_key"
            ]
          }
        ]
      },
      "message": "target_config.sink_config.post_export_archive.pgp_encryption.sign_with_private_key_secret is not valid alongside 'passphrase_secret' -- signing needs a sender keypair, which symmetric (passphrase) encryption does not have.",
      "field_path": "target_config.sink_config.post_export_archive.pgp_encryption.sign_with_private_key_secret.secret_key",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "gzip_archive_ignores_zip_password",
      "severity": "warning",
      "scope": "flow",
      "when": {
        "and": [
          {
            "eq": [
              "target_config.sink_config.post_export_archive.archive_format",
              "gzip"
            ]
          },
          {
            "nonempty": [
              "target_config.sink_config.post_export_archive.secret.secret_key"
            ]
          }
        ]
      },
      "message": "post_export_archive.secret (the AES ZIP password) has no effect when archive_format is 'gzip' -- a gzip stream has no archive password. Use pgp_encryption to protect a gzip export, or switch archive_format to 'zip'.",
      "field_path": "target_config.sink_config.post_export_archive.secret.secret_key",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "export_trigger_enum",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.sink_config.export_trigger"
            ]
          },
          {
            "nin": [
              "target_config.sink_config.export_trigger",
              [
                "per_micro_batch",
                "per_update"
              ]
            ]
          }
        ]
      },
      "message": "target_config.sink_config.export_trigger must be one of ['per_micro_batch', 'per_update']. Absent means 'per_micro_batch', the only pre-v1.7.5 behaviour.",
      "field_path": "target_config.sink_config.export_trigger",
      "doc": "#6-egress-and-lakeflow-sinks"
    },
    {
      "id": "export_trigger_pgp_zip_only",
      "severity": "error",
      "scope": "flow",
      "when": {
        "and": [
          {
            "nonempty": [
              "target_config.sink_config.export_trigger"
            ]
          },
          {
            "ne": [
              "target_config.sink_config.format",
              "pgp_zip"
            ]
          }
        ]
      },
      "message": "sink_config.export_trigger is only meaningful for format 'pgp_zip' (this framework's staging-then-archive sink); 'delta' and 'kafka' are native Lakeflow sinks whose write cadence Lakeflow itself owns. Remove the attribute.",
      "field_path": "target_config.sink_config.export_trigger",
      "doc": "#6-egress-and-lakeflow-sinks"
    }
  ]
}
