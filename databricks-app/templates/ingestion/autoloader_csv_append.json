{
  "dataflow_id": "df_autoloader_csv_append",
  "source_system": "example_source_system",
  "source_database": "example_landing_db",
  "source_table_name": "example_raw_table",
  "source_description": "Bronze ingestion from a Volume (Auto Loader) with regex file selection, quarantine, encryption, and data standardization, in the {{env}} environment",
  "source_type": "autoloader",
  "target_catalog": "{{catalog}}",
  "target_schema": "bronze_example",
  "target_table": "example_raw",
  "target_type": "streaming_table",
  "source_config": {
    "path": "/Volumes/{{catalog}}/landing/example_raw_zone/incoming/",
    "format": "csv",
    "file_pattern": "orc_*",
    "schema_location": "/Volumes/{{catalog}}/landing/_schemas/example_raw/",
    "schema_evolution_mode": "rescue",
    "reader_options": {
      "header": "true",
      "cloudFiles.inferColumnTypes": "true"
    },
    "data_standardization_sql": [
      "trim(region) AS region",
      "upper(country_code) AS country_code"
    ],
    "landing_retention_policy": {
      "clean_source": "archive",
      "archive_path": "/Volumes/{{catalog}}/landing/_archive/example/",
      "retention_days": 7
    },
    "capture_technical_metadata": true,
    "remove_dups": false,
    "column_normalization": {
      "enabled": true,
      "case": "lower"
    }
  },
  "target_config": {
    "cdc_load_strategy": "APPEND",
    "storage_format": "delta",
    "partition_columns": [
      "region"
    ],
    "liquid_clustering_columns": [
      "example_id"
    ],
    "auto_ttl": {
      "timestamp_column": "updated_at",
      "expire_in_days": 90
    },
    "table_properties": {
      "log_retention_duration": "interval 30 days",
      "deleted_file_retention_duration": "interval 30 days"
    },
    "encrypted_columns": [
      {
        "column_name": "pii_column",
        "output_column": "pii_column",
        "mode": "GCM",
        "source_data_type": "string",
        "secret": {
          "secret_catalog": "{{catalog}}",
          "secret_schema": "security",
          "secret_key": "pii_encryption_key"
        }
      }
    ]
  },
  "dq_config": {
    "rules": [
      {
        "rule_id": "dq_example_id_not_null",
        "expression": "example_id IS NOT NULL",
        "action": "drop"
      },
      {
        "rule_id": "dq_amount_non_negative",
        "expression": "amount >= 0",
        "action": "quarantine"
      }
    ],
    "quarantine_table": "example_raw_quarantine",
    "record_id_column": "example_id"
  },
  "governance_tags": {
    "column_tags": [
      {
        "column": "pii_column",
        "tags": {
          "mask": "PII",
          "classification": "restricted"
        }
      }
    ],
    "table_tags": {
      "row_filter": "region_restricted",
      "domain": "example"
    }
  }
}
