{
  "_use_case": "UC6 -- Flood Warning System (Environment Agency -> Leidos). Matches EA flood-risk area postcodes against EE mobile customer addresses to identify the MSISDNs to warn, replacing a ~10-year-old Ab Initio ETL. Binding design: docs/UC6/BUILD_CONTRACT.md. Every deviation from the supplied brief, with evidence: docs/UC6/FRAMEWORK_CAPABILITY_MAP.md.",
  "dataflow_group_id": "dfg_uc6_ea_flood_warning",
  "pipeline_parameters": {
    "match_strength_threshold": 50,
    "min_addresses_per_area": 1,
    "min_age_years": 17,
    "excluded_business_unit_code": "BS",
    "export_file_date": "2026-08-20",
    "export_file_sequence": "1of1"
  },
  "ingestion_flows": [
    {
      "dataflow_id": "df_uc6_ea_request_ingest",
      "source_system": "env_agency",
      "source_database": "uc6_flood_warning",
      "source_table_name": "ea_request",
      "source_description": "UC6: the Environment Agency's weekly flood-risk address request (PAF-shaped, 14 pipe-delimited fields WITH a header row). Delivered gzip-then-GPG-symmetric (AES256); the framework decrypts the envelope using the flowx.config.pgpkey UC secret and decompresses the gzip member before Auto Loader reads it, all inside one pipeline update.",
      "source_type": "autoloader",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze",
      "target_table": "uc6_ea_request",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/staging/uc_6/_extracted/ea_request/",
        "format": "csv",
        "schema_location": "/Volumes/{{catalog}}/staging/uc_6/_schemas/ea_request/",
        "file_pattern": "EE_*-REQUEST_*.csv",
        "reader_options": {
          "header": "true",
          "delimiter": "|",
          "mode": "PERMISSIVE"
        },
        "capture_technical_metadata": true,
        "source_zip_handling": {
          "enabled": true,
          "source_zip_path": "/Volumes/{{catalog}}/staging/uc_6/raw/",
          "zip_file_pattern": "EE_*-REQUEST_*[Oo][Ff]*.csv.gz.gpg",
          "target_volume_path": "/Volumes/{{catalog}}/staging/uc_6/_extracted/ea_request/",
          "member_format": "gzip",
          "pre_extraction_decryption": {
            "type": "pgp_symmetric",
            "passphrase_secret": {
              "secret_catalog": "{{catalog}}",
              "secret_schema": "config",
              "secret_key": "pgpkey"
            }
          },
          "delete_source_after_extract": {
            "action": "delete_now"
          }
        }
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "uc6_ea_target_area_present",
            "expression": "targetAreaID IS NOT NULL AND length(trim(targetAreaID)) > 0",
            "action": "fail"
          },
          {
            "rule_id": "uc6_ea_osapr_present",
            "expression": "osapr IS NOT NULL AND length(trim(osapr)) > 0",
            "action": "fail"
          },
          {
            "rule_id": "uc6_ea_target_area_max_32",
            "expression": "length(targetAreaID) <= 32",
            "action": "warn"
          },
          {
            "rule_id": "uc6_ea_osapr_max_12_digits",
            "expression": "length(trim(osapr)) <= 12",
            "action": "warn"
          },
          {
            "rule_id": "uc6_ea_postcode_max_7",
            "expression": "postcode IS NULL OR length(replace(trim(postcode), ' ', '')) <= 7",
            "action": "warn"
          }
        ]
      },
      "governance_tags": {
        "table_tags": {
          "use_case": "uc6",
          "source_system": "env_agency",
          "data_classification": "confidential",
          "pii": "false",
          "owner": "business_data_and_ai",
          "environment": "poc"
        }
      }
    },
    {
      "dataflow_id": "df_uc6_css_account_address_ingest",
      "source_system": "css",
      "source_database": "uc6_flood_warning",
      "source_table_name": "css_account_address",
