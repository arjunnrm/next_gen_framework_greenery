      "source_database": "uc6_flood_warning",
      "source_table_name": "jt_customer",
      "source_description": "UC6: JT Customer Details (PAYG/OUK). 34 pipe-delimited fields, headerless, carrying address and MSISDN inline -- there is no separate address feed for this channel.",
      "source_type": "autoloader",
