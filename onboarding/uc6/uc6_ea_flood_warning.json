      "source_table_name": "css_subscription",
      "source_description": "UC6: CSS subscription records (PAYM/OUK) carrying the MSISDN. 47 pipe-delimited fields, headerless. The driving side of the CSS three-way join.",
      "source_type": "autoloader",
