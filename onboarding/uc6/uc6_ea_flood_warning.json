      "source_system": "css",
      "source_database": "uc6_flood_warning",
      "source_table_name": "css_account",
      "source_description": "UC6: CSS account records (PAYM/OUK) carrying dateofbirth and customerbusinessunitcode -- the two documented business filters (age > 17, unit code != 'BS'). 56 pipe-delimited fields, headerless. NOTE the file_pattern is CSS_account_[0-9]*, not CSS_account_*: the latter ALSO matches CSS_account_address_*, whose 19-field schema would corrupt this 56-field table.",
      "source_type": "autoloader",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze",
      "target_table": "uc6_css_account",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/staging/uc_6/_extracted/css_account/",
        "format": "csv",
        "schema_location": "/Volumes/{{catalog}}/staging/uc_6/_schemas/css_account/",
        "file_pattern": "CSS_account_[0-9]*.dat.gz",
        "reader_options": {
          "header": "false",
          "delimiter": "|",
          "mode": "PERMISSIVE"
        },
        "capture_technical_metadata": true,
        "schema_config_path": "/Volumes/{{catalog}}/staging/uc_6/_schema_configs/uc6_css_account.json"
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "uc6_css_acct_customerid_present",
            "expression": "customerid IS NOT NULL",
            "action": "drop"
          }
        ]
      },
      "governance_tags": {
        "table_tags": {
          "use_case": "uc6",
