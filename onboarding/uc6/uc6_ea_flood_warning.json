  ],
  "transformation_flows": [
    {
      "flow_step_id": "ts_uc6_ea_base",
      "dataflow_id": "df_uc6_ea_request_ingest",
      "source_description": "UC6 silver: the EA base file -- one row per osapr, carrying its targetAreaID. The legacy design dedupes the request feed on {osapr}; ROW_NUMBER over the ingestion timestamp makes 'which duplicate wins' explicit and deterministic rather than arbitrary.",
      "target_catalog": "{{catalog}}",
      "target_schema": "silver",
      "target_table": "uc6_ea_base",
      "target_type": "materialized_view",
      "source_inputs": [
        {
          "input_name": "uc6_ea_request_base",
          "table": "{{catalog}}.bronze.uc6_ea_request",
          "is_streaming": true
        }
      ],
      "transformation_sql": "SELECT targetAreaID, osapr, postcode, town FROM (SELECT targetAreaID, trim(osapr) AS osapr, postcode, town, ROW_NUMBER() OVER (PARTITION BY trim(osapr) ORDER BY __framework_ingestion_timestamp_utc DESC) AS rn FROM uc6_ea_request_base WHERE osapr IS NOT NULL AND trim(osapr) <> '') WHERE rn = 1",
      "target_config": {
        "cdc_load_strategy": "TRUNCATE_AND_LOAD",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": []
      },
      "governance_tags": {
        "table_tags": {
          "use_case": "uc6",
          "source_system": "env_agency",
          "data_classification": "confidential",
          "pii": "false",
          "owner": "business_data_and_ai",
          "environment": "poc"
        }
      }
    },
    {
      "flow_step_id": "ts_uc6_ea_address",
      "dataflow_id": "df_uc6_ea_request_ingest",
      "source_description": "UC6 silver: the normalised EA address set -- deduped on {postcode, address, town} per the legacy design, carrying osapr for the join back to the base file. PO Box rows are retained here and excluded at match time, so the exclusion is visible in one place rather than implied by absence.",
      "target_catalog": "{{catalog}}",
      "target_schema": "silver",
      "target_table": "uc6_ea_address",
      "target_type": "materialized_view",
      "source_inputs": [
        {
          "input_name": "uc6_ea_request_addr",
          "table": "{{catalog}}.bronze.uc6_ea_request",
          "is_streaming": true
        }
      ],
      "transformation_sql": "SELECT osapr, postcode_norm, address_norm, town_norm, has_po_box, targetAreaID FROM (SELECT trim(osapr) AS osapr, nullif(upper(regexp_replace(coalesce(postcode, ''), '[^A-Za-z0-9]', '')), '') AS postcode_norm, concat_ws(' ', nullif(trim(regexp_replace(regexp_replace(upper(coalesce(sub_bld_name, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(bld_name, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(bld_number, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(thfare2, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(thfare1, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(dbl_dep_loc, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(dep_loc, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '')) AS address_norm, nullif(trim(regexp_replace(regexp_replace(upper(coalesce(town, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '') AS town_norm, CASE WHEN po_box IS NOT NULL AND trim(po_box) <> '' THEN true ELSE false END AS has_po_box, targetAreaID, ROW_NUMBER() OVER (PARTITION BY nullif(upper(regexp_replace(coalesce(postcode, ''), '[^A-Za-z0-9]', '')), ''), concat_ws(' ', nullif(trim(regexp_replace(regexp_replace(upper(coalesce(sub_bld_name, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(bld_name, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(bld_number, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(thfare2, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(thfare1, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(dbl_dep_loc, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(dep_loc, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '')), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(town, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '') ORDER BY trim(osapr)) AS rn FROM uc6_ea_request_addr WHERE osapr IS NOT NULL AND trim(osapr) <> '') WHERE rn = 1",
      "target_config": {
        "cdc_load_strategy": "TRUNCATE_AND_LOAD",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": []
      },
      "governance_tags": {
        "table_tags": {
          "use_case": "uc6",
          "source_system": "env_agency",
          "data_classification": "confidential",
          "pii": "false",
          "owner": "business_data_and_ai",
          "environment": "poc"
        }
      }
    },
    {
      "flow_step_id": "ts_uc6_ee_address_paf",
      "dataflow_id": "df_uc6_ea_request_ingest",
      "source_description": "UC6 silver: every EE address normalised into the common PAF shape and unioned -- CSS (PAYM/OUK, the three-way join plus the age>17 and unit-code<>'BS' business filters), JT (PAYG/OUK) and Excalibur (EE/TMUK). One flow with a UNION ALL rather than three staging tables, per the repo's Single-Read DAG mandate rule 3: reshaping before a union belongs inside the consuming table. Excalibur's two record variants are reconciled with a coalesce rather than a separate branch.",
      "target_catalog": "{{catalog}}",
      "target_schema": "silver",
      "target_table": "uc6_ee_address_paf",
      "target_type": "streaming_table",
      "source_inputs": [
        {
          "input_name": "uc6_css_sub",
          "table": "{{catalog}}.bronze.uc6_css_subscription",
          "is_streaming": true
        },
        {
          "input_name": "uc6_css_acct",
          "table": "{{catalog}}.bronze.uc6_css_account",
          "is_streaming": false
        },
        {
          "input_name": "uc6_css_addr",
          "table": "{{catalog}}.bronze.uc6_css_account_address",
          "is_streaming": false
        },
        {
          "input_name": "uc6_jt_cust",
          "table": "{{catalog}}.bronze.uc6_jt_customer",
          "is_streaming": false
        },
        {
          "input_name": "uc6_exc_addr",
          "table": "{{catalog}}.bronze.uc6_excalibur_address",
          "is_streaming": false
        }
      ],
      "transformation_sql": "SELECT 'css' AS source_system, s.msisdn AS msisdn, nullif(upper(regexp_replace(coalesce(a.postcode, ''), '[^A-Za-z0-9]', '')), '') AS postcode_norm, concat_ws(' ', nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.building_name1, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.building_name, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.building_number, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.street1, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.street2, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.locality1, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.locality2, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '')) AS address_norm, nullif(trim(regexp_replace(regexp_replace(upper(coalesce(a.county, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '') AS town_norm, CASE WHEN a.po_box IS NOT NULL AND trim(a.po_box) <> '' THEN true ELSE false END AS has_po_box FROM uc6_css_sub s INNER JOIN uc6_css_acct c ON s.customerid = c.customerid INNER JOIN uc6_css_addr a ON c.customerid = a.customerid WHERE c.customerbusinessunitcode <> ${excluded_business_unit_code} AND c.dateofbirth IS NOT NULL AND floor((months_between(current_date(), to_date(c.dateofbirth, 'yyyy-MM-dd'))) / 12) > ${min_age_years} AND s.msisdn IS NOT NULL AND trim(s.msisdn) <> '' UNION ALL SELECT 'jt' AS source_system, msisdn, nullif(upper(regexp_replace(coalesce(postcode, ''), '[^A-Za-z0-9]', '')), '') AS postcode_norm, concat_ws(' ', nullif(trim(regexp_replace(regexp_replace(upper(coalesce(building_number, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(street2, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(locality2, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '')) AS address_norm, nullif(trim(regexp_replace(regexp_replace(upper(coalesce(town, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '') AS town_norm, false AS has_po_box FROM uc6_jt_cust WHERE dateofbirth IS NOT NULL AND floor((months_between(current_date(), to_date(dateofbirth, 'yyyyMMdd'))) / 12) > ${min_age_years} AND msisdn IS NOT NULL AND trim(msisdn) <> '' UNION ALL SELECT 'excalibur' AS source_system, msisdn, nullif(upper(regexp_replace(coalesce(adr_post_code, ''), '[^A-Za-z0-9]', '')), '') AS postcode_norm, concat_ws(' ', nullif(trim(regexp_replace(regexp_replace(upper(coalesce(adr_house_name, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), coalesce(nullif(trim(regexp_replace(regexp_replace(upper(coalesce(concat_ws(' ', adr_house_no, adr_primary_ln), '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), ''), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(adr_addr_line1, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '')), nullif(trim(regexp_replace(regexp_replace(upper(coalesce(adr_district, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '')) AS address_norm, nullif(trim(regexp_replace(regexp_replace(upper(coalesce(adr_district, '')), '[^A-Z0-9 ]', ' '), ' +', ' ')), '') AS town_norm, false AS has_po_box FROM uc6_exc_addr WHERE msisdn IS NOT NULL AND trim(msisdn) <> ''",
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "uc6_paf_postcode_present",
            "expression": "postcode_norm IS NOT NULL",
            "action": "drop"
          },
          {
            "rule_id": "uc6_paf_msisdn_present",
            "expression": "msisdn IS NOT NULL",
            "action": "drop"
          }
        ]
      },
