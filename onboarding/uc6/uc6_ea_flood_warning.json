    {
      "flow_step_id": "ts_uc6_matched_address",
      "dataflow_id": "df_uc6_ea_request_ingest",
      "source_description": "UC6 silver: EA addresses matched to EE addresses on normalised postcode, excluding PO Boxes, scored by address-token overlap. IMPORTANT: match_strength is a DOCUMENTED ASSUMPTION -- the legacy Ab Initio scoring algorithm appears in none of the supplied documents. It is deliberately confined to this one expression, and the threshold is a pipeline parameter, so it can be replaced wholesale when the real algorithm surfaces. See docs/UC6/BUILD_CONTRACT.md section 6.",
      "target_catalog": "{{catalog}}",
      "target_schema": "silver",
      "target_table": "uc6_matched_address",
      "target_type": "streaming_table",
      "source_inputs": [
        {
          "input_name": "uc6_ea_addr_match",
          "table": "{{catalog}}.silver.uc6_ea_address",
          "is_streaming": false
        },
        {
          "input_name": "uc6_ee_paf_match",
          "table": "{{catalog}}.silver.uc6_ee_address_paf",
          "is_streaming": true
        }
      ],
      "transformation_sql": "SELECT ea.osapr, ea.targetAreaID, ea.postcode_norm AS postcode, ea.address_norm AS address, ea.town_norm AS town, ee.msisdn AS msisdn, ee.source_system, CASE WHEN ea.address_norm IS NULL OR ee.address_norm IS NULL THEN 0 ELSE cast(round(100.0 * size(array_intersect(split(ea.address_norm, ' '), split(ee.address_norm, ' '))) / greatest(size(split(ea.address_norm, ' ')), 1)) AS INT) END AS match_strength FROM uc6_ee_paf_match ee INNER JOIN uc6_ea_addr_match ea ON ee.postcode_norm = ea.postcode_norm WHERE ea.has_po_box = false AND ee.has_po_box = false",
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": []
      },
      "governance_tags": {
        "table_tags": {
          "use_case": "uc6",
          "source_system": "derived",
          "data_classification": "confidential",
          "pii": "true",
          "owner": "business_data_and_ai",
          "environment": "poc"
        }
      }
    },
    {
      "flow_step_id": "ts_uc6_osapr_output",
      "dataflow_id": "df_uc6_ea_request_ingest",
      "source_description": "UC6 gold: one row per (targetAreaID, osapr) with its match COUNT and STATUS. Implements the four documented branches: Found (above threshold and the area has >1 matched address), Not Found (above threshold but only one), Bad OSAPR (at or below threshold), Single Addr (the area only ever had one address candidate at all). Both thresholds are pipeline parameters, never literals.",
      "target_catalog": "{{catalog}}",
      "target_schema": "gold",
      "target_table": "uc6_osapr_output",
      "target_type": "materialized_view",
      "source_inputs": [
        {
          "input_name": "uc6_ea_base_osapr",
          "table": "{{catalog}}.silver.uc6_ea_base",
          "is_streaming": false
        },
        {
          "input_name": "uc6_matched_osapr",
          "table": "{{catalog}}.silver.uc6_matched_address",
          "is_streaming": false
        }
      ],
      "transformation_sql": "WITH scored AS (  SELECT b.targetAreaID, b.osapr, max(coalesce(m.match_strength, 0)) AS best_match_strength,          count(DISTINCT m.msisdn) AS count_of_msisdn   FROM uc6_ea_base_osapr b LEFT JOIN uc6_matched_osapr m ON b.osapr = m.osapr   GROUP BY b.targetAreaID, b.osapr), area AS (  SELECT targetAreaID,          count(*) AS candidate_osapr_count,          sum(CASE WHEN best_match_strength > ${match_strength_threshold} THEN 1 ELSE 0 END) AS matched_osapr_count   FROM scored GROUP BY targetAreaID) SELECT s.targetAreaID, s.osapr,   CASE WHEN s.best_match_strength > ${match_strength_threshold}             AND a.matched_osapr_count > ${min_addresses_per_area} THEN 1 ELSE 0 END AS count,   CASE WHEN a.candidate_osapr_count <= ${min_addresses_per_area} THEN 'Single Addr'        WHEN s.best_match_strength <= ${match_strength_threshold} THEN 'Bad OSAPR'        WHEN a.matched_osapr_count > ${min_addresses_per_area} THEN 'Found'        ELSE 'Not Found' END AS status,   s.count_of_msisdn, a.matched_osapr_count AS count_of_osapr, s.best_match_strength AS match_strength FROM scored s JOIN area a ON s.targetAreaID = a.targetAreaID",
      "target_config": {
        "cdc_load_strategy": "TRUNCATE_AND_LOAD",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "uc6_osapr_status_known",
            "expression": "status IN ('Found', 'Not Found', 'Bad OSAPR', 'Single Addr')",
            "action": "fail"
          },
          {
            "rule_id": "uc6_osapr_count_numeric_max_999",
            "expression": "count BETWEEN 0 AND 999",
            "action": "fail"
          },
          {
            "rule_id": "uc6_osapr_target_area_max_32",
            "expression": "length(targetAreaID) <= 32",
            "action": "warn"
          },
          {
            "rule_id": "uc6_osapr_max_12_digits",
            "expression": "length(osapr) <= 12",
            "action": "warn"
          },
          {
            "rule_id": "uc6_osapr_status_max_100",
            "expression": "length(status) <= 100",
            "action": "warn"
          }
        ]
      },
      "governance_tags": {
        "table_tags": {
          "use_case": "uc6",
          "source_system": "derived",
          "data_classification": "confidential",
          "pii": "true",
          "owner": "business_data_and_ai",
          "environment": "poc"
        }
      }
    },
    {
      "flow_step_id": "ts_uc6_telephone_output",
      "dataflow_id": "df_uc6_ea_request_ingest",
      "source_description": "UC6 gold: the telephone list. Case 1 of the design (above threshold, MSISDN populated, and the area has more than one matched address) is included; Case 2 (only one matched address in the area) is EXCLUDED -- an anti-singling-out privacy safeguard, not an optimisation, so it is expressed as an explicit join against the areas that qualify rather than as a filter that could be lost in a rewrite.",
