  "transformation_flows": [
    {
      "flow_step_id": "ts_snk001_ea_joined_assignments_sink",
      "dataflow_id": "df_snk001_assignments_ingest",
      "target_catalog": "{{catalog}}",
      "target_schema": "silver_ea",
      "target_table": "snk001_ea_joined_assignments",
      "target_type": "external_sink",
      "source_inputs": [
        {"input_name": "snk001_assignments_raw", "table": "{{catalog}}.bronze_ea.snk001_assignments_raw", "is_streaming": true},
        {"input_name": "snk001_employees_raw", "table": "{{catalog}}.bronze_ea.snk001_employees_raw", "is_streaming": false},
        {"input_name": "snk001_departments_raw", "table": "{{catalog}}.bronze_ea.snk001_departments_raw", "is_streaming": false},
        {"input_name": "snk001_projects_raw", "table": "{{catalog}}.bronze_ea.snk001_projects_raw", "is_streaming": false}
      ],
      "transformation_sql": "SELECT a.employee_id, a.project_id, a.hours_allocated, e.employee_name, e.role, e.dept_id, d.dept_name, d.region, p.project_name, p.budget FROM snk001_assignments_raw a JOIN snk001_employees_raw e ON a.employee_id = e.employee_id JOIN snk001_departments_raw d ON e.dept_id = d.dept_id JOIN snk001_projects_raw p ON a.project_id = p.project_id",
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta",
        "sink_config": {
          "path": "/Volumes/{{catalog}}/egress_ea/export_zips/_staging/snk001/",
          "format": "pgp_zip",
          "post_export_archive": {
            "enabled": true,
            "output_zip_path": "/Volumes/{{catalog}}/egress_ea/export_zips/output/snk001/",
            "export_file_name_format": "snk001_ea_joined_export_{batch_id}"
          }
        }
      },
      "dq_config": {"rules": []},
      "governance_tags": {}
    }
  ],
  "reconciliation_flows": []
