{
  "dataflow_group_id": "dfg_sec_001_aes_encrypt",
  "pipeline_parameters": {},
  "ingestion_flows": [
    {
      "dataflow_id": "df_sec_001_customer_pii_ingest",
      "source_system": "customer_pii_source",
      "source_database": "customers",
      "source_table_name": "customer_pii_raw",
      "source_description": "TC-SEC-001: batch Auto Loader customer PII feed -- verifies target_config.encrypted_columns encrypts 'ssn' and 'credit_card' with AES-GCM (random IV) before the target table is ever materialized, keyed off the project's existing {{catalog}}.security.pii_encryption_key Unity Catalog secret",
      "source_type": "autoloader",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze_customers",
      "target_table": "customer_pii_encrypted",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/customers/landing_pii/incoming/",
        "format": "csv",
        "schema_location": "/Volumes/{{catalog}}/customers/_schemas/customer_pii_encrypted/",
        "reader_options": {"header": "true", "cloudFiles.inferColumnTypes": "true"},
        "capture_technical_metadata": true
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta",
        "encrypted_columns": [
          {
            "column_name": "ssn",
            "output_column": "ssn",
            "mode": "GCM",
            "secret": {"secret_catalog": "{{catalog}}", "secret_schema": "security", "secret_key": "pii_encryption_key"}
          },
          {
            "column_name": "credit_card",
            "output_column": "credit_card",
            "mode": "GCM",
            "secret": {"secret_catalog": "{{catalog}}", "secret_schema": "security", "secret_key": "pii_encryption_key"}
          }
        ]
      },
      "dq_config": {"rules": []},
      "governance_tags": {}
    }
  ],
  "transformation_flows": [],
  "reconciliation_flows": []
}
