    {
      "flow_step_id": "ts_trf001_ea_joined_assignments",
      "dataflow_id": "df_trf001_assignments_ingest",
      "target_catalog": "{{catalog}}",
      "target_schema": "silver_ea",
      "target_table": "trf001_ea_joined_assignments",
      "target_type": "streaming_table",
      "source_inputs": [
        {"input_name": "assignments_raw", "table": "{{catalog}}.bronze_ea.trf001_assignments_raw", "is_streaming": true},
        {"input_name": "employees_raw", "table": "{{catalog}}.bronze_ea.trf001_employees_raw", "is_streaming": false},
        {"input_name": "departments_raw", "table": "{{catalog}}.bronze_ea.trf001_departments_raw", "is_streaming": false},
        {"input_name": "projects_raw", "table": "{{catalog}}.bronze_ea.trf001_projects_raw", "is_streaming": false}
      ],
      "transformation_sql": "SELECT a.employee_id, a.project_id, a.hours_allocated, e.employee_name, e.role, e.dept_id, d.dept_name, d.region, p.project_name, p.budget FROM assignments_raw a JOIN employees_raw e ON a.employee_id = e.employee_id JOIN departments_raw d ON e.dept_id = d.dept_id JOIN projects_raw p ON a.project_id = p.project_id",
      "target_config": {"cdc_load_strategy": "APPEND", "storage_format": "delta"},
