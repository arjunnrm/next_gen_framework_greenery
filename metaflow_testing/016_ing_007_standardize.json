{
  "dataflow_group_id": "dfg_metaflow_ing_007_standardize",
  "pipeline_parameters": {},
  "ingestion_flows": [
    {
      "dataflow_id": "df_ing_007_standardize",
      "source_system": "master_data_platform",
      "source_database": "master",
      "source_table_name": "companies_feed",
      "source_description": "Metaflow test TC-ING-007: inline data_standardization_sql normalizes dirty region/email values (whitespace + casing) on ingest, before the row ever reaches the Bronze table",
      "source_type": "autoloader",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze_master",
      "target_table": "companies_standardized",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/master/landing_companies/",
        "format": "csv",
        "schema_location": "/Volumes/{{catalog}}/master/_schemas/companies_standardized/",
        "reader_options": {"header": "true", "cloudFiles.inferColumnTypes": "true"},
        "data_standardization_sql": [
          "TRIM(UPPER(region)) AS region",
          "LOWER(TRIM(email)) AS email"
        ],
        "capture_technical_metadata": true
      },
      "target_config": {"cdc_load_strategy": "APPEND", "storage_format": "delta"},
      "dq_config": {"rules": []},
      "governance_tags": {}
    }
  ],
  "transformation_flows": [],
  "reconciliation_flows": []
}
