{
  "dataflow_group_id": "dfg_obs_001_json_log",
  "pipeline_parameters": {},
  "ingestion_flows": [
    {
      "dataflow_id": "df_obs_001_structured_log_ingest",
      "source_system": "observability_test_feed",
      "source_database": "ea_test",
      "source_table_name": "structured_log_events",
      "source_description": "TC-OBS-001: minimal batch Auto Loader ingestion (5 rows, 1 quarantined) combining a quarantine-action dq_config rule with an SCD1 cdc_load_strategy on one flow, so ingestion_read, dq_staging, and flow_registration structured JSON log events all fire from a single pipeline run, plus cdc_change_capture from the downstream governance task -- see observability/structured_logger.py::log_flow_event for the real emitted field set",
      "source_type": "autoloader",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze_ea",
      "target_table": "test_structured_log_raw",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/ea/landing_obs_json_log/",
        "format": "csv",
        "schema_location": "/Volumes/{{catalog}}/ea/_schemas/test_structured_log_raw/",
        "reader_options": {"header": "true", "cloudFiles.inferColumnTypes": "true"},
        "capture_technical_metadata": true
      },
      "target_config": {
        "cdc_load_strategy": "SCD1",
        "primary_keys": ["event_id"],
        "sequence_by_column": "event_ts",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "dq_obs_001_amount_not_null",
            "expression": "amount IS NOT NULL",
            "action": "quarantine"
          }
        ],
        "quarantine_table": "test_structured_log_raw_quarantine",
        "record_id_column": "event_id"
      },
      "governance_tags": {}
    }
  ],
  "transformation_flows": [],
  "reconciliation_flows": []
}
