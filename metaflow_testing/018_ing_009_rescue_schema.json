{
  "dataflow_group_id": "dfg_ing_009_rescue_schema",
  "pipeline_parameters": {},
  "ingestion_flows": [
    {
      "dataflow_id": "df_ing_009_rescue_schema_ingest",
      "source_system": "ops_drift_feed",
      "source_database": "ops",
      "source_table_name": "feed_rescued_raw",
      "source_description": "TC-ING-009: schema evolution + malformed column rescue -- a day-2 CSV batch introduces an unannounced 'unannounced_flag' column plus a non-numeric value in the typed 'id' column; schema_evolution_mode: 'rescue' captures both into _rescued_data instead of failing the stream or silently dropping data",
      "source_type": "autoloader",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze_ops",
      "target_table": "feed_rescued_raw",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/ops/landing_drift/",
        "format": "csv",
        "schema_location": "/Volumes/{{catalog}}/ops/_schemas/feed_rescued_raw/",
        "schema_evolution_mode": "rescue",
        "reader_options": {"header": "true", "cloudFiles.inferColumnTypes": "true"},
        "capture_technical_metadata": true
      },
      "target_config": {"cdc_load_strategy": "APPEND", "storage_format": "delta"},
      "dq_config": {},
      "governance_tags": {}
    }
  ],
  "transformation_flows": [],
  "reconciliation_flows": []
}
