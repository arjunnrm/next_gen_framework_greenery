{
  "$schema": "../../../onboarding_templates/onboarding_spec.schema.json",
  "_about": {
    "use_case": "UC3 - Excalibur batch load and reconciliation (Job 3 of 3)",
    "description": "Lands the four dated Excalibur batch CSV sets into flowx.staging.<table>_batch with Auto Loader, reconciles each against its flowx.bronze CDC target on primary key and compare columns, and heals missing rows back through the streaming lane. Design and evidence: BT_Usecase/UC3/docs/UC3_MASTER_DOCUMENT.md.",
    "version": "FlowX 0.0.4",
    "date": "2026-09-05",
    "developer": "Madhan Raghu"
  },
  "dataflow_group_id": "dfg_uc3_excalibur_batch_recon",
  "pipeline_parameters": {
    "landing_root": "/Volumes/flowx/staging/uc_3/batch"
  },
  "ingestion_flows": [
    {
      "dataflow_id": "df_uc3_physical_device_batch_load",
      "source_system": "excalibur",
      "source_database": "excalibur",
      "source_table_name": "PHYSICAL_DEVICE",
      "source_description": "Dated Excalibur PHYSICAL_DEVICE batch extracts, one batch_date=YYYY-MM-DD partition folder per set (2026-08-01..04).",
      "source_type": "autoloader",
      "target_catalog": "flowx",
      "target_schema": "staging",
      "target_table": "physical_device_batch",
      "target_type": "streaming_table",
      "source_config": {
        "path": "${landing_root}/physical_device/",
        "format": "csv",
        "schema_location": "/Volumes/flowx/staging/uc_3/_schemas/physical_device_batch/",
        "reader_options": {
          "header": "true",
          "delimiter": ",",
          "cloudFiles.inferColumnTypes": "true"
        },
        "data_standardization_sql": [
          "CAST(NULL AS STRING) AS esn_pin",
          "CAST(NULL AS STRING) AS blacklist_password"
        ],
        "capture_technical_metadata": true,
        "column_normalization": {
          "enabled": true,
          "case": "lower"
        }
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "partition_columns": [
          "batch_date"
        ]
      },
      "governance_tags": {
        "column_tags": [
          {
            "column": "esn_pin",
            "tags": {
              "sensitive": "N",
              "tokenise_pii": "Y",
              "csql_ro": "Y",
              "csql_secured_ro": "Y",
              "bq_deid_ro": "?",
              "data_fabric_action": "NULL_AT_SOURCE"
            }
          },
          {
            "column": "blacklist_password",
            "tags": {
              "sensitive": "Y",
              "tokenise_pii": "N",
              "csql_ro": "N",
              "csql_secured_ro": "N",
              "bq_deid_ro": "Y",
              "data_fabric_action": "NULL_AT_SOURCE"
            }
          }
        ],
        "table_tags": {
          "source_system": "excalibur",
          "use_case": "uc3",
          "domain": "crm",
          "layer": "staging",
          "load_pattern": "batch"
        }
      }
    },
    {
      "dataflow_id": "df_uc3_customer_batch_load",
      "source_system": "excalibur",
      "source_database": "excalibur",
      "source_table_name": "CUSTOMER",
      "source_description": "Dated Excalibur CUSTOMER batch extracts, one batch_date=YYYY-MM-DD partition folder per set (2026-08-01..04).",
      "source_type": "autoloader",
      "target_catalog": "flowx",
      "target_schema": "staging",
      "target_table": "customer_batch",
      "target_type": "streaming_table",
      "source_config": {
        "path": "${landing_root}/customer/",
        "format": "csv",
        "schema_location": "/Volumes/flowx/staging/uc_3/_schemas/customer_batch/",
        "reader_options": {
          "header": "true",
          "delimiter": ",",
          "cloudFiles.inferColumnTypes": "true"
        },
        "data_standardization_sql": [
          "CAST(NULL AS STRING) AS acc_password",
          "CAST(NULL AS STRING) AS imei_black_list_pass",
          "CAST(NULL AS STRING) AS gur_cr_card_no"
        ],
        "capture_technical_metadata": true,
        "column_normalization": {
          "enabled": true,
          "case": "lower"
        }
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "partition_columns": [
          "batch_date"
        ]
      },
      "governance_tags": {
        "column_tags": [
          {
            "column": "acc_password",
            "tags": {
              "sensitive": "Y",
              "tokenise_pii": "?",
              "csql_ro": "N",
              "csql_secured_ro": "N",
              "bq_deid_ro": "Y",
              "data_fabric_action": "NULL_AT_SOURCE"
            }
          },
          {
            "column": "imei_black_list_pass",
            "tags": {
              "sensitive": "N",
              "tokenise_pii": "?",
              "csql_ro": "N",
              "csql_secured_ro": "N",
              "bq_deid_ro": "Y",
              "data_fabric_action": "NULL_AT_SOURCE"
            }
          },
          {
            "column": "gur_cr_card_no",
            "tags": {
              "sensitive": "Y",
              "tokenise_pii": "?",
              "csql_ro": "N",
              "csql_secured_ro": "N",
              "bq_deid_ro": "Y",
              "data_fabric_action": "NULL_AT_SOURCE"
            }
          }
        ],
        "table_tags": {
          "source_system": "excalibur",
          "use_case": "uc3",
          "domain": "crm",
          "layer": "staging",
          "load_pattern": "batch"
        }
      }
    },
    {
      "dataflow_id": "df_uc3_subscriber_batch_load",
      "source_system": "excalibur",
      "source_database": "excalibur",
      "source_table_name": "SUBSCRIBER",
      "source_description": "Dated Excalibur SUBSCRIBER batch extracts, one batch_date=YYYY-MM-DD partition folder per set (2026-08-01..04).",
      "source_type": "autoloader",
      "target_catalog": "flowx",
      "target_schema": "staging",
      "target_table": "subscriber_batch",
      "target_type": "streaming_table",
      "source_config": {
        "path": "${landing_root}/subscriber/",
        "format": "csv",
        "schema_location": "/Volumes/flowx/staging/uc_3/_schemas/subscriber_batch/",
        "reader_options": {
