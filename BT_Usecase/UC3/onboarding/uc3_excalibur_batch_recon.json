          "case": "lower"
        }
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "partition_columns": [
          "batch_date"
        ]
      },
      "governance_tags": {
        "table_tags": {
          "source_system": "excalibur",
          "use_case": "uc3",
          "domain": "crm",
          "layer": "staging",
          "load_pattern": "batch"
        }
      }
    }
  ],
  "reconciliation_flows": [
    {
      "reconciliation_id": "rf_uc3_physical_device_batch_vs_bronze",
      "execution_mode": "pipeline",
      "dataflow_group_id": "dfg_uc3_excalibur_batch_recon",
      "publish_schema": "staging",
      "source_config": {
        "type": "table",
        "table": "flowx.staging.physical_device_batch",
        "read_mode": "batch",
        "hash_precomputed": false
      },
      "target_configs": [
        {
          "target_id": "bronze_physical_device",
          "type": "table",
          "table": "flowx.bronze.physical_device",
          "read_mode": "batch",
          "hash_precomputed": false,
          "comparison_direction": "both",
          "append_target_table": "flowx.staging.physical_device_stream"
        }
      ],
      "match_keys": [
        "customer_id",
        "subscriber_no",
        "equipment_no",
        "phy_seq_no"
      ],
      "compare_columns": [
        "operator_id",
        "application_id",
