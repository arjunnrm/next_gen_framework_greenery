{
  "$schema": "../../../onboarding_templates/onboarding_spec.schema.json",
  "_about": {
    "use_case": "UC7 - CDR ASN.1 decode to Bronze",
    "description": "Decodes raw BER-encoded call detail records from four network elements (EMSC, PSGW, SGSN, TAP3.10) against their ASN.1 modules and lands one streaming table per element in <catalog>.bronze, routing undecodable records to per-table quarantine. Design and evidence: BT_Usecase/UC7/docs/UC7_MASTER_DOCUMENT.md.",
    "version": "FlowX 0.0.4",
    "date": "2026-09-08",
    "developer": "Madhan Raghu"
  },
  "dataflow_group_id": "dfg_uc7_cdr_asn",
  "pipeline_parameters": {},
  "ingestion_flows": [
    {
      "dataflow_id": "df_uc7_emsc_cdr_ingest",
      "source_system": "emsc_cdr_feed",
      "source_database": "uc_7",
      "source_table_name": "emsc_call_data_record",
      "source_description": "UC_7 EMSC (mobile switching centre) BER-encoded call data records, decoded against EMSC.asn1 (module MSC12A). Root PDU auto-detected as CallDataRecord, a CHOICE -- decoding projects one column per arm plus the _choice discriminator. Concatenated-TLV: one .raw file holds many records.",
      "source_type": "asn1",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze",
      "target_table": "emsc_cdr_raw",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/staging/uc_7/raw/EMSC/",
        "schema_location": "/Volumes/{{catalog}}/staging/uc_7/_schemas/emsc_cdr_raw/",
        "asn1_schema_path": "/Volumes/{{catalog}}/staging/uc_7/asn_schema/EMSC.asn1",
        "asn1_codec": "ber",
        "capture_technical_metadata": true
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "dq_emsc_asn1_decode_ok",
            "expression": "_asn1_decode_error IS NULL",
            "action": "quarantine"
          },
          {
            "rule_id": "dq_emsc_choice_arm_selected",
            "expression": "_choice IS NOT NULL AND _choice <> ''",
            "action": "quarantine"
          },
          {
            "rule_id": "dq_emsc_arm_populated",
            "expression": "_choice <> 'uMTSGSMPLMNCallDataRecord' OR uMTSGSMPLMNCallDataRecord IS NOT NULL",
            "action": "quarantine"
          }
        ],
        "quarantine_table": "emsc_cdr_raw_quarantine",
        "record_id_column": "_choice"
      },
      "governance_tags": {}
    },
    {
      "dataflow_id": "df_uc7_psgw_cdr_ingest",
      "source_system": "psgw_cdr_feed",
      "source_database": "uc_7",
      "source_table_name": "psgw_call_event_record",
      "source_description": "UC_7 PSGW (packet-switched gateway, PGW/SGW) BER-encoded call event records, decoded against PSGW.asn1 (module CDRF-R9). Root PDU auto-detected as CallEventRecord; observed arms sGWRecord and pGWRecord. Concatenated-TLV.",
      "source_type": "asn1",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze",
      "target_table": "psgw_cdr_raw",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/staging/uc_7/raw/PSGW/",
        "schema_location": "/Volumes/{{catalog}}/staging/uc_7/_schemas/psgw_cdr_raw/",
        "asn1_schema_path": "/Volumes/{{catalog}}/staging/uc_7/asn_schema/PSGW.asn1",
        "asn1_codec": "ber",
        "capture_technical_metadata": true
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "dq_psgw_asn1_decode_ok",
            "expression": "_asn1_decode_error IS NULL",
            "action": "quarantine"
          },
          {
            "rule_id": "dq_psgw_choice_arm_selected",
            "expression": "_choice IS NOT NULL AND _choice <> ''",
            "action": "quarantine"
          }
        ],
        "quarantine_table": "psgw_cdr_raw_quarantine",
        "record_id_column": "_choice"
      },
      "governance_tags": {}
    },
    {
      "dataflow_id": "df_uc7_sgsn_cdr_ingest",
      "source_system": "sgsn_cdr_feed",
      "source_database": "uc_7",
      "source_table_name": "sgsn_call_event_record",
      "source_description": "UC_7 SGSN (serving GPRS support node) BER-encoded call event records, decoded against SGSN.asn1 (module CDRF-R9). Root PDU auto-detected as CallEventRecord; all observed records select sgsnPDPRecord. Concatenated-TLV and large: one 42MB .fin file holds 175,048 records.",
      "source_type": "asn1",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze",
      "target_table": "sgsn_cdr_raw",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/staging/uc_7/raw/SGSN/",
        "schema_location": "/Volumes/{{catalog}}/staging/uc_7/_schemas/sgsn_cdr_raw/",
        "asn1_schema_path": "/Volumes/{{catalog}}/staging/uc_7/asn_schema/SGSN.asn1",
        "asn1_codec": "ber",
        "capture_technical_metadata": true
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "dq_sgsn_asn1_decode_ok",
            "expression": "_asn1_decode_error IS NULL",
            "action": "quarantine"
          },
          {
            "rule_id": "dq_sgsn_choice_arm_selected",
            "expression": "_choice IS NOT NULL AND _choice <> ''",
            "action": "quarantine"
          },
          {
            "rule_id": "dq_sgsn_arm_populated",
            "expression": "_choice <> 'sgsnPDPRecord' OR sgsnPDPRecord IS NOT NULL",
            "action": "quarantine"
          }
        ],
        "quarantine_table": "sgsn_cdr_raw_quarantine",
        "record_id_column": "_choice"
      },
      "governance_tags": {}
    },
    {
      "dataflow_id": "df_uc7_tap310_ingest",
      "source_system": "tap310_tap_feed",
      "source_database": "uc_7",
      "source_table_name": "tap310_data_interchange",
      "source_description": "UC_7 TAP 3.10 transferred-account-procedure data interchange batches, decoded against TAP.310.asn1 (module TAP-0310). Root PDU auto-detected as DataInterChange, a 2-arm CHOICE; observed files select transferBatch. Version proven from the payload: SpecificationVersionNumber=3, ReleaseVersionNumber=10. Each file is ONE batch wrapping its own record list, so one file yields one row by design.",
      "source_type": "asn1",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze",
      "target_table": "tap310_raw",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/staging/uc_7/raw/TAP/",
        "schema_location": "/Volumes/{{catalog}}/staging/uc_7/_schemas/tap310_raw/",
        "asn1_schema_path": "/Volumes/{{catalog}}/staging/uc_7/asn_schema/TAP.310.asn1",
        "asn1_codec": "ber",
        "capture_technical_metadata": true
      },
      "target_config": {
        "cdc_load_strategy": "APPEND",
        "storage_format": "delta"
      },
      "dq_config": {
        "rules": [
          {
            "rule_id": "dq_tap310_asn1_decode_ok",
            "expression": "_asn1_decode_error IS NULL",
            "action": "quarantine"
          },
          {
            "rule_id": "dq_tap310_choice_arm_selected",
            "expression": "_choice IS NOT NULL AND _choice <> ''",
            "action": "quarantine"
          },
          {
            "rule_id": "dq_tap310_arm_populated",
            "expression": "_choice <> 'transferBatch' OR transferBatch IS NOT NULL",
            "action": "quarantine"
          }
        ],
        "quarantine_table": "tap310_raw_quarantine",
        "record_id_column": "_choice"
      },
      "governance_tags": {}
    }
  ],
  "transformation_flows": [],
  "reconciliation_flows": [],
  "observability": [
    {
      "id": "dest-uc7-volume",
      "enabled": true,
      "type": "DATABRICKS_VOLUME",
      "destination_config": {
        "volume_path": "/Volumes/{{catalog}}/observability/app_logs/",
        "compression": "GZIP",
        "file_format": "JSONL"
      }
    }
  ]
}
