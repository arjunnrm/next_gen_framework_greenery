{
  "dataflow_group_id": "dfg_cdc_002_truncate",
  "pipeline_parameters": {},
  "ingestion_flows": [
    {
      "dataflow_id": "df_cdc_002_fx_rates_ingest",
      "source_system": "treasury_fx_feed",
      "source_database": "treasury",
      "source_table_name": "fx_rates_daily",
      "source_description": "TC-CDC-002: daily full-replacement FX currency rate extract (50 currency rows) landed via Auto Loader into Bronze -- the raw feed itself is a plain append-only landing; the downstream transformation flow is the one that must fully recompute (TRUNCATE_AND_LOAD) rather than accumulate",
      "source_type": "autoloader",
      "target_catalog": "{{catalog}}",
      "target_schema": "bronze_ref",
      "target_table": "fx_rates_raw",
      "target_type": "streaming_table",
      "source_config": {
        "path": "/Volumes/{{catalog}}/ref/landing_fx/incoming/",
        "format": "csv",
        "schema_location": "/Volumes/{{catalog}}/ref/_schemas/fx_rates_raw/",
        "reader_options": {"header": "true", "cloudFiles.inferColumnTypes": "true"},
        "capture_technical_metadata": true
      },
      "target_config": {"cdc_load_strategy": "APPEND", "storage_format": "delta"},
      "dq_config": {"rules": []},
      "governance_tags": {}
    }
  ],
  "transformation_flows": [
    {
      "flow_step_id": "ts_cdc_002_fx_rates_truncate_load",
      "dataflow_id": "df_cdc_002_fx_rates_ingest",
      "target_catalog": "{{catalog}}",
      "target_schema": "silver_ref",
      "target_table": "dim_fx_rates_current",
      "target_type": "materialized_view",
      "source_inputs": [
        {
          "input_name": "fx_rates_raw_src",
          "table": "{{catalog}}.bronze_ref.fx_rates_raw",
          "is_streaming": false
        }
      ],
      "transformation_sql": "SELECT currency_code, rate_date, exchange_rate FROM fx_rates_raw_src",
      "target_config": {"cdc_load_strategy": "TRUNCATE_AND_LOAD", "storage_format": "delta"},
      "dq_config": {"rules": []},
      "governance_tags": {}
    }
  ],
  "reconciliation_flows": []
}
